# Never copy host install over image `npm ci` (causes "cannot replace directory with file" on @auth/core, etc.)
node_modules

# Next / caches
.next
out
.turbo
.vercel

# VCS & editor
.git
.gitignore
.cursor
.idea
.vscode

# Logs & debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Test & coverage
coverage
.nyc_output
playwright-report
test-results

# Local env only — CI may still place `.env` in the build context for NEXT_PUBLIC_* / build
.env.local
.env.development.local
.env.test.local
.env.production.local

# Large / runtime-only paths (keep build context small)
public/uploads
