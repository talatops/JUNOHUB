{
  "name": "pdc-poc",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev",
    "prebuild": "npx prisma generate",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:gmail-auto-reply": "set -e; docker compose -f tests/gmail-auto-reply/docker-compose.test.yml up -d; export $(cat tests/gmail-auto-reply/env.test | grep -v '^#' | xargs); docker compose -f tests/gmail-auto-reply/docker-compose.test.yml exec -T db sh -lc \"psql -U postgres -d dropshipping -c 'CREATE EXTENSION IF NOT EXISTS vector;'\"; npx prisma migrate deploy; npx tsx tests/gmail-auto-reply/seed.ts; vitest run tests/gmail-auto-reply/run.test.ts; docker compose -f tests/gmail-auto-reply/docker-compose.test.yml down -v",
    "re-embed-knowledge-base": "tsx scripts/re-embed-knowledge-base.ts",
    "db:reset": "prisma migrate reset",
    "db:apply-gmail-reply-theme-column": "prisma db execute --file prisma/migrations/20260412160000_store_gmail_reply_theme/migration.sql",
    "db:baseline-migrations": "bash scripts/prisma-baseline-record-all-applied.sh",
    "db:studio": "prisma studio",
    "db:fix-migration": "tsx scripts/fix-failed-migration.ts",
    "db:role-audit": "tsx scripts/audit-role-consistency.ts"
  },
  "dependencies": {
    "@auth/core": "^0.41.0",
    "@auth/prisma-adapter": "^2.11.1",
    "@aws-sdk/client-s3": "^3.989.0",
    "@prisma/adapter-pg": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "@tailwindcss/postcss": "^4",
    "@types/nodemailer": "^7.0.9",
    "@types/qrcode": "^1.5.6",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3",
    "aws-cli": "^0.0.2",
    "aws-sdk": "^2.1693.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.4",
    "framer-motion": "^12.33.0",
    "lenis": "^1.3.17",
    "lucide-react": "^0.563.0",
    "mammoth": "^1.11.0",
    "next": "^16.2.1",
    "next-auth": "^5.0.0-beta.30",
    "nodemailer": "^7.0.7",
    "openai": "^4.104.0",
    "otplib": "^13.2.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.18.0",
    "prisma": "^7.6.0",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hot-toast": "^2.6.0",
    "recharts": "^3.7.0",
    "tailwind-merge": "^3.4.0",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "20.19.39",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^3.0.5"
  },
  "browserslist": [
    "last 2 versions",
    "not dead",
    "> 0.5%",
    "not ie 11"
  ]
}
